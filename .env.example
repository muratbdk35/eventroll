# EventRoll environment variables.
# Copy to .env.local for local development. Never commit real values.
# Validated at startup by lib/env.ts. Values marked [prod] are optional locally
# (dev fallbacks are used) but required in the production deployment.

# ── App ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EventRoll
DEFAULT_LOCALE=en
# [prod] Protects /api/cron/* (Vercel Cron sends it as a Bearer token). `openssl rand -hex 32`
CRON_SECRET=
# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=
# [prod] Salt for hashing guest IP+UA fingerprints. `openssl rand -hex 32`
FINGERPRINT_SALT=

# ── Database (Neon, region: eu-central-1 / Frankfurt) ──────────────────
# Neon pooled connection string. Local dev: the `dev` branch, never production.
# (pglite:memory works for tests/builds only; `next dev` needs a shared Postgres.)
DATABASE_URL=

# ── Auth (Better Auth) ─────────────────────────────────────────────────
# At least 32 chars. `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (Web client). Redirect URI: {APP_URL}/api/auth/callback/google
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage (Cloudflare R2, private bucket; use a separate dev bucket) ──
# [prod]
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# https://<account_id>.r2.cloudflarestorage.com (or the EU jurisdiction endpoint)
R2_ENDPOINT=

# ── Bot protection (Cloudflare Turnstile, managed mode) ────────────────
# [prod]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Payments (Stripe; use TEST mode keys in development) ───────────────
# [prod]
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MINI=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_VIP=
STRIPE_TAX_ENABLED=true

# ── Email (Resend; verify sending domain with SPF/DKIM/DMARC) ──────────
# [prod] Without these, emails are printed to the server console in dev.
RESEND_API_KEY=
EMAIL_FROM="EventRoll <hello@eventroll.eu>"
SUPPORT_EMAIL=

# ── Rate limiting (Upstash Redis) ──────────────────────────────────────
# [prod] Without these, an in-memory limiter is used in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Product analytics (PostHog EU Cloud) ───────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ── Error tracking (Sentry, EU region) ─────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for source map upload (optional)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Marketing pixels (loaded only after cookie consent) ────────────────
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=

# Explicit-image check for guest uploads (Sightengine, DECISIONS #52).
# Without these, uploads are simply not checked.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
